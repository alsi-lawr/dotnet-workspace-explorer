<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Dotnet.CLI.Plus</AssemblyName>
        <RootNamespace>Dotnet.CLI.Plus</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-plus</ToolCommandName>
        <PackageOutputPath>../../build</PackageOutputPath>
        <Description>Additional solution-management commands for the .NET CLI.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Dotnet.CLI.Plus.Core/Dotnet.CLI.Plus.Core.fsproj" />
        <ProjectReference Include="../Dotnet.CLI.Plus.Solution/Dotnet.CLI.Plus.Solution.fsproj" />
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Compatibility.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
