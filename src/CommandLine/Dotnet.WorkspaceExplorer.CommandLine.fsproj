        <Compile Include="Verification/ReferencePostconditions.fs" />
        <Compile Include="Verification/TemplatePostconditions.fs" />
        <Compile Include="Execution/DotnetProcess.fs" />
        <Compile Include="Solutions/CommandLineLaunchProfiles.fs" />
        <Compile Include="Solutions/LegacyDirectoryImport.fs" />
        <Compile Include="DirectCommandRunner.fs" />
        <Compile Include="Rendering/DirectCommandRendering.fs" />
