        <Compile Include="Parsing/CommandOptionScanner.fs" />
        <Compile Include="Parsing/SolutionCommandParser.fs" />
        <Compile Include="Parsing/PackageCommandParser.fs" />
        <Compile Include="Parsing/ReferenceCommandParser.fs" />
        <Compile Include="Parsing/TemplateCommandParser.fs" />
        <Compile Include="Parsing/DirectCommandParser.fs" />
        <Compile Include="Targets/CommandTargetDiscovery.fs" />
        <Compile Include="Packages/FilePackageDirectives.fs" />
        <Compile Include="Packages/PackageUpdateTargets.fs" />
        <Compile Include="Templates/TemplateEngineInstallation.fs" />
