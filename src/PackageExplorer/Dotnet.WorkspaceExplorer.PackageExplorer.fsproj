<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Dotnet.WorkspaceExplorer.PackageExplorer</AssemblyName>
        <RootNamespace>Dotnet.WorkspaceExplorer.PackageExplorer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Packages/Dotnet.WorkspaceExplorer.Packages.fsproj" />
        <ProjectReference Include="../ProjectEvaluation/Dotnet.WorkspaceExplorer.ProjectEvaluation.csproj" />
        <ProjectReference Include="../Solutions/Dotnet.WorkspaceExplorer.Solutions.fsproj" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="NuGet.Configuration" />
        <PackageReference Include="NuGet.Frameworks" />
        <PackageReference Include="NuGet.ProjectModel" />
        <PackageReference Include="NuGet.Protocol" />
        <PackageReference Include="NuGet.Versioning" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
        <Compile Include="Application/PackagePorts.fs" />
        <Compile Include="Sources/PackageMetadata.fs" />
        <Compile Include="Sources/NuGetSourceFailures.fs" />
        <Compile Include="Sources/NuGetSources.fs" />
        <Compile Include="Installed/InstalledPackageGraphs.fs" />
        <Compile Include="Installed/NuGetInstalledPackages.fs" />
        <Compile Include="Sources/NuGetPackageSearch.fs" />
        <Compile Include="Sources/NuGetPackageDetails.fs" />
        <Compile Include="Sources/NuGetPackageCatalog.fs" />
        <Compile Include="Startup/PackageStartup.fs" />
    </ItemGroup>
</Project>
