<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Dotnet.WorkspaceExplorer</AssemblyName>
        <RootNamespace>Dotnet.WorkspaceExplorer</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-we</ToolCommandName>
        <PackageOutputPath>../../build</PackageOutputPath>
        <PackageId>ALSI.WorkspaceExplorer</PackageId>
        <Title>dotnet-workspace-explorer</Title>
        <Description>Power terminal and editor solution explorers for .NET workspaces.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/alsi-lawr/dotnet-workspace-explorer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/alsi-lawr/dotnet-workspace-explorer.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>dotnet;solution;workspace;explorer;cli;tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReadmeSource>$(MSBuildProjectDirectory)/../../README.md</PackageReadmeSource>
        <PackageReadmeOutput>$(MSBuildProjectExtensionsPath)package/README.md</PackageReadmeOutput>
        <PackageReadmeGenerator>$(MSBuildProjectDirectory)/../../scripts/PackageReadme.fsx</PackageReadmeGenerator>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Workspaces/Dotnet.WorkspaceExplorer.Workspaces.fsproj" />
        <ProjectReference Include="../Solutions/Dotnet.WorkspaceExplorer.Solutions.fsproj" />
        <ProjectReference Include="../Rpc/Dotnet.WorkspaceExplorer.Rpc.fsproj" />
        <ProjectReference Include="../ProjectEvaluation/Dotnet.WorkspaceExplorer.ProjectEvaluation.csproj" />
        <ProjectReference Include="../WorkspaceIndex/Dotnet.WorkspaceExplorer.WorkspaceIndex.fsproj" />
        <ProjectReference Include="../WorkspaceEditing/Dotnet.WorkspaceExplorer.WorkspaceEditing.fsproj" />
        <ProjectReference Include="../WorkspaceCommands/Dotnet.WorkspaceExplorer.WorkspaceCommands.fsproj" />
        <ProjectReference Include="../CommandLine/Dotnet.WorkspaceExplorer.CommandLine.fsproj" />
        <ProjectReference Include="../Packages/Dotnet.WorkspaceExplorer.Packages.fsproj" />
        <ProjectReference Include="../PackageExplorer/Dotnet.WorkspaceExplorer.PackageExplorer.fsproj" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.Build.Locator" IncludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
        <Compile Include="RpcHosting/WorkspaceOperations.fs" />
        <Compile Include="RpcHosting/WorkspaceGitStatusContracts.fs" />
        <Compile Include="RpcHosting/WorkspaceGitStatusParsing.fs" />
        <Compile Include="RpcHosting/WorkspaceGitStatusMapping.fs" />
        <Compile Include="RpcHosting/WorkspaceGitProcess.fs" />
        <Compile Include="RpcHosting/WorkspaceGitStatus.fs" />
        <Compile Include="RpcHosting/AddExisting/Contracts.fs" />
        <Compile Include="RpcHosting/AddExisting/Selector.fs" />
        <Compile Include="RpcHosting/WorkspaceRpcContexts.fs" />
        <Compile Include="RpcHosting/WorkspaceNavigationRequests.fs" />
        <Compile Include="RpcHosting/WorkspaceExportRequests.fs" />
        <Compile Include="DotnetCommands/WorkspaceCommandExecution.fs" />
        <Compile Include="RpcHosting/WorkspaceCommandArguments.fs" />
        <Compile Include="RpcHosting/WorkspaceTemplateCatalog.fs" />
        <Compile Include="RpcHosting/ContextWorkspaceActions.fs" />
        <Compile Include="RpcHosting/AddExisting/Mutation.fs" />
        <Compile Include="RpcHosting/ContextWorkspacePhysicalBatch.fs" />
        <Compile Include="RpcHosting/ContextWorkspaceSolutionBatch.fs" />
        <Compile Include="RpcHosting/ContextWorkspaceBatchActions.fs" />
        <Compile Include="DotnetCommands/DotnetCommandCompensation.fs" />
        <Compile Include="DotnetCommands/DotnetCommandOperation.fs" />
        <Compile Include="WorkspaceEditing/WorkspaceEditOperation.fs" />
        <Compile Include="RpcHosting/DotnetLifecycleRequests.fs" />
        <Compile Include="RpcHosting/SolutionLaunchProfileRequests.fs" />
        <Compile Include="RpcHosting/WorkspaceCommandRequests.fs" />
        <Compile Include="RpcHosting/WorkspaceRpcInvocation.fs" />
        <Compile Include="RpcHosting/WorkspaceRpcServer.fs" />
        <Compile Include="Hosting/ProgramInvocation.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <None Include="$(PackageReadmeOutput)" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>
    <Target
        Name="GeneratePackageReadme"
        BeforeTargets="GenerateNuspec"
        Inputs="$(PackageReadmeSource);$(PackageReadmeGenerator)"
        Outputs="$(PackageReadmeOutput)">
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PackageReadmeOutput)'))" />
        <Exec
            Command="dotnet fsi &quot;$(PackageReadmeGenerator)&quot; &quot;$(PackageReadmeSource)&quot; &quot;$(PackageReadmeOutput)&quot;" />
    </Target>
</Project>
