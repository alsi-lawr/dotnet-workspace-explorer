<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Dotnet.WorkspaceExplorer.WorkspaceIndex</AssemblyName>
        <RootNamespace>Dotnet.WorkspaceExplorer.WorkspaceIndex</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Workspaces/Dotnet.WorkspaceExplorer.Workspaces.fsproj" />
        <ProjectReference Include="../Solutions/Dotnet.WorkspaceExplorer.Solutions.fsproj" />
