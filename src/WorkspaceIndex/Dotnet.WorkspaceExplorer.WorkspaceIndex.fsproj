        <Compile Include="Projection/ExploredProjectProperties.fs" />
        <Compile Include="Projection/WorkspaceIndexModel.fs" />
        <Compile Include="Projection/Dependencies/DependencyDetails.fs" />
        <Compile Include="Projection/SemanticProjectProjection.fs" />
        <Compile Include="Projection/WorkspaceNodeProjection.fs" />
        <Compile Include="Projection/WorkspaceIndexDiff.fs" />
        <Compile Include="Watching/WorkspaceWatchPlan.fs" />
        <Compile Include="Paging/WorkspacePageTokens.fs" />
        <Compile Include="WorkspaceIndexContracts.fs" />
        <Compile Include="Exporting/WorkspaceExportScheduler.fs" />
