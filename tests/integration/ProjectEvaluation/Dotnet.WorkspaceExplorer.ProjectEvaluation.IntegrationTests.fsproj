<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <AssemblyName>Dotnet.WorkspaceExplorer.ProjectEvaluation.IntegrationTests</AssemblyName>
        <RootNamespace>Dotnet.WorkspaceExplorer.ProjectEvaluation.IntegrationTests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Testing/RepositoryBuild.fs" />
        <Compile Include="Workers/EvaluationWorkerIsolationTests.fs" />
        <Compile Include="ProjectEvaluation/CentralPackageOwnershipTests.fs" />
        <Compile Include="ProjectEvaluation/ProjectCapabilityTests.fs" />
        <Compile Include="Workers/EvaluationWorkerCompatibilityTests.fs" />
        <Compile Include="ProjectEvaluation/SdkSelectionTests.fs" />
        <Compile Include="ProjectEvaluation/ProjectInputFailureTests.fs" />
        <Compile Include="WorkspaceExport/ExportCancellationTests.fs" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../../Fixtures/ProjectEvaluation/**/*" Link="Fixtures/ProjectEvaluation/%(RecursiveDir)%(Filename)%(Extension)" Pack="false" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../../src/WorkspaceExplorer/Dotnet.WorkspaceExplorer.fsproj" />
        <ProjectReference Include="../../../src/Workspaces/Dotnet.WorkspaceExplorer.Workspaces.fsproj" />
        <ProjectReference Include="../../../src/ProjectEvaluation/Dotnet.WorkspaceExplorer.ProjectEvaluation.csproj" />
        <ProjectReference Include="../../../src/Rpc/Dotnet.WorkspaceExplorer.Rpc.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="FsUnit.Xunit" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
</Project>
