<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <AssemblyName>Dotnet.WorkspaceExplorer.PackageExplorer.UnitTests</AssemblyName>
        <RootNamespace>Dotnet.WorkspaceExplorer.PackageExplorer.UnitTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="PackageContractTests.fs" />
        <Compile Include="NuGetPackageCatalogTests.fs" />
        <Compile Include="InstalledPackageGraphTests.fs" />
        <Compile Include="PackageStartupTests.fs" />
        <Compile Include="ProgramInvocationTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../src/Packages/Dotnet.WorkspaceExplorer.Packages.fsproj" />
        <ProjectReference Include="../../../src/PackageExplorer/Dotnet.WorkspaceExplorer.PackageExplorer.fsproj" />
        <ProjectReference Include="../../../src/ProjectEvaluation/Dotnet.WorkspaceExplorer.ProjectEvaluation.csproj" />
        <ProjectReference Include="../../../src/WorkspaceExplorer/Dotnet.WorkspaceExplorer.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="FsUnit.Xunit" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
</Project>
